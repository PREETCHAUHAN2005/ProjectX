# Implementation env names (not source-confirmed). Never put secret values here.

# --- frontend (Vite) ---
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_WS_URL=ws://127.0.0.1:8000/ws
# Optional Colab / FastAPI emotion service. POST { "text": "..." } → { "emotions": [{ "label", "score" }] }
VITE_MODEL_URL=

# --- backend ---
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Optional stores — app starts without them in Phase 2 (implementation)
REDIS_URL=redis://127.0.0.1:6379/0
MONGODB_URI=
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# Telegram (Telethon) — never commit real values
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
# IMPLEMENTATION: comma-separated public channel usernames
TELEGRAM_CHANNELS=

# X ingestion backend: ntscraper | official_api (implementation switch; not source-confirmed)
X_INGESTION_BACKEND=ntscraper
X_BEARER_TOKEN=
