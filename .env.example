# Implementation env names (not source-confirmed). Never put secret values here.

# --- frontend (Vite) ---
# Leave empty for local demo so the Vite proxy (same origin) reaches FastAPI.
VITE_API_BASE_URL=
VITE_WS_URL=
# Optional Colab / FastAPI emotion service. POST { "text": "..." } → { "emotions": [{ "label", "score" }] }
VITE_MODEL_URL=

# --- backend ---
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173

# Local demo: seed analyzed posts + live WebSocket loop. Set false in tests.
DEMO_MODE=true
# auto tries X (ntscraper / official API), then falls back to the local replay corpus.
# replay is the reliable SIH local-demo default (still analyzed through the real pipeline).
DEMO_INGEST=replay
DEMO_INTERVAL_SECONDS=4
# lexicon = 28-d GoEmotions space without downloading PyTorch. huggingface = SamLowe/roberta-base-go_emotions
EMOTION_BACKEND=lexicon

# Optional stores — app starts without them (in-memory fallback)
REDIS_URL=redis://127.0.0.1:6379/0
MONGODB_URI=
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# Telegram (Telethon) — never commit real values
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
# IMPLEMENTATION: comma-separated public channel usernames
TELEGRAM_CHANNELS=

# X ingestion backend: ntscraper | official_api (implementation switch; not source-confirmed)
X_INGESTION_BACKEND=ntscraper
X_BEARER_TOKEN=
X_QUERY=India
